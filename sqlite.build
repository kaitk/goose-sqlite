// The package's C: SQLite's amalgamation, vendored unchanged in vendor/sqlite/,
// and the shim over it. Both compile with SQLite's compile-time options, each
// justified in docs/decisions.md ("SQLite's compile-time options").
c_sources = ["shim/sqlite.c", "vendor/sqlite/sqlite3.c"];
c_include = ["vendor/sqlite"];
c_defines = [
    "SQLITE_THREADSAFE=2",
    "SQLITE_DQS=0",
    "SQLITE_DEFAULT_MEMSTATUS=0",
    "SQLITE_DEFAULT_WAL_SYNCHRONOUS=1",
    "SQLITE_LIKE_DOESNT_MATCH_BLOBS",
    "SQLITE_OMIT_DECLTYPE",
    "SQLITE_OMIT_DEPRECATED",
    "SQLITE_OMIT_PROGRESS_CALLBACK",
    "SQLITE_OMIT_SHARED_CACHE",
    "SQLITE_OMIT_AUTOINIT",
    "SQLITE_STRICT_SUBTYPE=1",
    "SQLITE_OMIT_LOAD_EXTENSION",
    "SQLITE_MAX_WORKER_THREADS=0",
];
// The shim's _Static_assert is C11, which MSVC takes only when asked.
c_flags_msvc = ["/std:c11"];
// build/ holds the compiler scripts/goose.sh fetches, whose stdlib declares the
// runtime's extern fns.
exclude = ["build"];
